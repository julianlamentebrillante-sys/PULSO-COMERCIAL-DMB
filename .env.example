# Conexión a Supabase (Project Settings → API / Data API).
# Copia este archivo como .env.local y completa los valores.
# Sin estos valores la aplicación funciona como prototipo local (datos en el navegador).
#
# La clave "anon / publishable" es pública por diseño: la seguridad la dan las
# reglas RLS de la base de datos. NUNCA pongas aquí la clave service_role / secret.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
